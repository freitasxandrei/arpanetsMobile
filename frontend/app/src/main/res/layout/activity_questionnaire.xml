                android:text="@string/answer_no" />
        </RadioGroup>

        <!-- P11 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11 - Tem dificuldade em realizar suas atividades diárias com satisfação?"
            android:textStyle="bold" />
        <RadioGroup android:id="@+id/rgQ11"
