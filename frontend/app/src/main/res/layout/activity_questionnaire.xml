            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" >
            <RadioButton android:id="@+id/rb3Y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="60dp"
                android:text="@string/answer_yes" />
            <RadioButton android:id="@+id/rb3N"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_no" />
        </RadioGroup>

        <!-- P4 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 - Assusta-se com facilidade?"
            android:textStyle="bold" />
        <RadioGroup android:id="@+id/rgQ4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" >
            <RadioButton android:id="@+id/rb4Y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="60dp"
                android:text="@string/answer_yes" />
            <RadioButton android:id="@+id/rb4N"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_no" />
        </RadioGroup>

        <!-- P5 -->
