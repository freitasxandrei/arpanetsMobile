<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layout_marginTop="26dp"
    android:padding="16dp"
    android:clipToPadding="false"
    tools:context=".QuestionnaireActivity"
    tools:ignore="HardcodedText, RtlSymmetry" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="16dp" >

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/questionnaire_title"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/questionnaire_text"
            android:textSize="14sp"
            android:textColor="#555"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvResult"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="50dp" />

        <TextView
            android:id="@+id/tvResultPercents"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Perguntas -->
        <!-- P1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 - Você tem dores de cabeça frequentes?"
            android:textStyle="bold" />
        <RadioGroup android:id="@+id/rgQ1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" >
            <RadioButton android:id="@+id/rb1Y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="60dp"
                android:text="@string/answer_yes" />
            <RadioButton android:id="@+id/rb1N"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_no" />
        </RadioGroup>

        <!-- P2 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 - Tem falta de apetite?"
            android:textStyle="bold" />
        <RadioGroup android:id="@+id/rgQ2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" >
            <RadioButton android:id="@+id/rb2Y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="60dp"
                android:text="@string/answer_yes" />
            <RadioButton android:id="@+id/rb2N"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_no" />
        </RadioGroup>

        <!-- P3 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 - Dorme mal?"
            android:textStyle="bold" />
