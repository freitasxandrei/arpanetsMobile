            <RadioButton android:id="@+id/rb12Y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="60dp"
                android:text="@string/answer_yes" />
            <RadioButton android:id="@+id/rb12N"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_no" />
        </RadioGroup>

        <!-- P13 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="13 - Seu trabalho é difícil ou causa sofrimento?"
            android:textStyle="bold" />
        <RadioGroup android:id="@+id/rgQ13"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" >
            <RadioButton android:id="@+id/rb13Y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="60dp"
                android:text="@string/answer_yes" />
            <RadioButton android:id="@+id/rb13N"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_no" />
        </RadioGroup>

        <!-- P14 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14 - É incapaz de desempenhar um papel útil em sua vida?"
            android:textStyle="bold" />
        <RadioGroup android:id="@+id/rgQ14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" >
            <RadioButton android:id="@+id/rb14Y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="60dp"
                android:text="@string/answer_yes" />
            <RadioButton android:id="@+id/rb14N"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_no" />
        </RadioGroup>

        <!-- P15 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15 - Tem perdido o interesse pelas coisas?"
            android:textStyle="bold" />
        <RadioGroup android:id="@+id/rgQ15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" >
            <RadioButton android:id="@+id/rb15Y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="60dp"
                android:text="@string/answer_yes" />
            <RadioButton android:id="@+id/rb15N"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_no" />
        </RadioGroup>

        <!-- P16 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16 - Você se sente uma pessoa inútil, sem préstimo?"
            android:textStyle="bold" />
        <RadioGroup android:id="@+id/rgQ16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" >
            <RadioButton android:id="@+id/rb16Y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="60dp"
                android:text="@string/answer_yes" />
            <RadioButton android:id="@+id/rb16N"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_no" />
        </RadioGroup>

        <!-- P17 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="17 - Tem tido ideia de acabar com a vida?"
            android:textStyle="bold" />
        <RadioGroup android:id="@+id/rgQ17"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" >
            <RadioButton android:id="@+id/rb17Y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="60dp"
                android:text="@string/answer_yes" />
            <RadioButton android:id="@+id/rb17N"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_no" />
        </RadioGroup>

        <!-- P18 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18 - Sente-se cansado(a) o tempo todo?"
            android:textStyle="bold" />
        <RadioGroup android:id="@+id/rgQ18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" >
            <RadioButton android:id="@+id/rb18Y"
                android:layout_width="wrap_content"
