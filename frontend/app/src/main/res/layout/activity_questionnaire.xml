            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6 - Sente-se nervoso(a), tenso(a) ou preocupado(a)?"
            android:textStyle="bold" />
        <RadioGroup android:id="@+id/rgQ6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" >
            <RadioButton android:id="@+id/rb6Y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="60dp"
                android:text="@string/answer_yes" />
            <RadioButton android:id="@+id/rb6N"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_no" />
        </RadioGroup>

        <!-- P7 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7 - Tem má digestão?"
            android:textStyle="bold" />
        <RadioGroup android:id="@+id/rgQ7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" >
            <RadioButton android:id="@+id/rb7Y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="60dp"
                android:text="@string/answer_yes" />
            <RadioButton android:id="@+id/rb7N"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_no" />
        </RadioGroup>

        <!-- P8 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8 - Tem dificuldades de pensar com clareza?"
            android:textStyle="bold" />
        <RadioGroup android:id="@+id/rgQ8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" >
            <RadioButton android:id="@+id/rb8Y"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="60dp"
                android:text="@string/answer_yes" />
            <RadioButton android:id="@+id/rb8N"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/answer_no" />
        </RadioGroup>

        <!-- P9 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
